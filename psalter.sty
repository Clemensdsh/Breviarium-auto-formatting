% ==================================================
% 35. 乐谱渲染宏（配合Python端使用）
% ==================================================
% 乐谱包装器 - 自动处理单栏切换
\newcommand{\psScore}[2][]{%
    % #1 = 可选标题/注释
    % #2 = gabc文件路径（不带扩展名）或内联代码
    \ifx&#1&%
        % 无标题
    \else%
        \psSingleRubric{#1}%
    \fi%
    \ifgregorioavailable%
        \gresetlyriccentering{firstletter}%
        \gregorioscore{#2}%
    \else%
        \begin{center}%
        \fbox{\parbox{0.8\textwidth}{\centering\textcolor{rubricred}{%
            [乐谱: #2]\\[0.5em]%
            \small 需要安装 GregorioTeX%
        }}}%
        \end{center}%
    \fi%
    \vspace{0.5em}%
}

% 内联GABC代码
\newcommand{\psScoreInline}[2][]{%
    \ifx&#1&\else\psSingleRubric{#1}\fi%
    \ifgregorioavailable%
        \gresetlyriccentering{firstletter}%
        \gabcsnippet{#2}%
    \else%
        \begin{center}%
        \fbox{\parbox{0.8\textwidth}{\centering\textcolor{rubricred}{%
            [内联乐谱]\\[0.5em]%
            \small 需要安装 GregorioTeX%
        }}}%
        \end{center}%
    \fi%
    \vspace{0.5em}%
}


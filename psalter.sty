% ==================================================
% 2. 字体配置 (LuaLaTeX / luatexja)
% ==================================================
\RequirePackage{fontspec}
\RequirePackage{luatexja-fontspec}

% 西文字体
\setmainfont{Times New Roman}[Ligatures=TeX, Scale=1.0]

% 中文字体 - 使用 luatexja-fontspec 的命令
\setmainjfont{SimSun}[
    BoldFont = SimHei,           % 粗体 -> 黑体
    ItalicFont = KaiTi,          % 斜体 -> 楷体
    BoldItalicFont = KaiTi,      % 粗斜体 -> 楷体
    BoldItalicFeatures = {FakeBold=3} % 并把这个楷体人工加粗 (数值越大越粗)
]
\newjfontfamily\songti{SimSun}[BoldFont=SimHei, ItalicFont=KaiTi]
\newjfontfamily\heiti{SimHei}[
    BoldFont=*,
    AutoFakeBold=2.5,
    AutoFakeSlant=0.2
]
\newjfontfamily\kaiti{KaiTi}[
    BoldFont=*,            % 粗体时仍使用楷体文件
    AutoFakeBold=2.5,      % 开启伪粗体（数字越大越粗）
    AutoFakeSlant=0.2      % 开启伪斜体（如果需要）
]


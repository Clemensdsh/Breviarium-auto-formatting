% ==================================================
% 22. 图片 - 智能缩放
% ==================================================
\newlength{\psDefaultImageHeight}
\setlength{\psDefaultImageHeight}{3.2cm}

\newlength{\psImageNaturalWidth}
\newlength{\psImageNaturalHeight}

% 图片边缘留空 - 左右各2.5mm
\newlength{\psImageMargin}
\setlength{\psImageMargin}{5mm}  % 左右共5mm (各2.5mm)

% 单栏图片
\newcommand{\psImage}[2][]{%
    \switchcolumn*%
    \switchcolumn[0]%
    \begin{center}%
        \ifthenelse{\equal{#1}{}}%
            {\includegraphics[height=\psDefaultImageHeight]{#2}}%
            {\includegraphics[height=#1]{#2}}%
    \end{center}%
    \switchcolumn[1]~%
    \vspace{0.3em}%
}

% 全宽图片 - 智能缩放（带边缘留空）
\newcommand{\psImageFullWidth}[2][]{%
    \end{paracol}%
    \begin{center}%
        \ifthenelse{\equal{#1}{}}%
        {%
            % 无高度参数：检查宽度，必要时缩放（留出边缘）
            \settowidth{\psImageNaturalWidth}{\includegraphics{#2}}%
            \ifdim\psImageNaturalWidth>\dimexpr\psTotalTextWidth-\psImageMargin\relax%
                \includegraphics[width=\dimexpr\psTotalTextWidth-\psImageMargin\relax]{#2}%
            \else%
                \includegraphics[height=\psDefaultImageHeight]{#2}%
            \fi%
        }%
        {%
            % 有高度参数：先按高度加载，再检查宽度（留出边缘）
            \settowidth{\psImageNaturalWidth}{\includegraphics[height=#1]{#2}}%
            \ifdim\psImageNaturalWidth>\dimexpr\psTotalTextWidth-\psImageMargin\relax%
                \includegraphics[width=\dimexpr\psTotalTextWidth-\psImageMargin\relax]{#2}%
            \else%
                \includegraphics[height=#1]{#2}%
            \fi%
        }%
    \end{center}%
    \begin{paracol}{2}%
}


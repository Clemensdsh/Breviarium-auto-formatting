{
    "latex-workshop.latex.recipe.default": "latexmk (lualatex)",
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (lualatex)",
            "tools": ["lualatexmk"]
        },
        {
            "name": "lualatex",
            "tools": ["lualatex"]
        },
        {
            "name": "lualatex x2",
            "tools": ["lualatex", "lualatex"]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "lualatexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-lualatex",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "lualatex",
            "command": "lualatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-shell-escape",
                "%DOC%"
            ],
            "env": {}
        }
    ],
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.log",
        "*.out",
        "*.fls",
        "*.fdb_latexmk",
        "*.synctex.gz",
        "*-toc-latin.tmp",
        "*-toc-chinese.tmp"
    ]
}
